# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# MULTI-TENANT MASTER SWITCH (Project Settings -> JWT Keys -> the legacy HS256 secret).
# Its mere presence turns multi-tenancy ON: tenant JWTs are minted, every page is scoped
# to the signed-in user's tenant, and RLS enforces the boundary. UNSET, the deployment
# runs single-tenant — one unscoped pool for everybody, under the legacy organisation
# identity in app_settings.
# The DEPLOYED app reads it from Streamlit Cloud -> Settings -> Secrets, NOT from this
# file, and it must sit at the TOP LEVEL there (a value indented under a [section] header
# is a different key). Set it in both places or local and published behave differently —
# Settings -> Accounts -> Deployment in the app reports which one it actually read.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Resend (Settings -> API Keys)
# One Resend account verifies ONE domain. Per-app sender identity comes
# from the local part, not a subdomain - a subdomain would consume its
# own domain slot on the plan. Use a distinct local part per app.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=app-noreply@your-verified-domain.com

# Streamlit cookie signing secret (random 32+ char string)
APP_SECRET_KEY=change-me-to-a-long-random-string

# Admin notifications
ADMIN_EMAIL=admin@example.org

# Tavily web search (free, no card) — https://app.tavily.com/ -> API Keys.
# Powers the "Search the web" discovery section. Optional; the feature shows a
# setup note when unset. Add the same key to Streamlit Cloud -> Settings ->
# Secrets for the deployed app.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — absolute path to the master Excel workbook. The app auto-syncs
# when the file's mtime is newer than the last recorded sync (shown on
# Admin > Settings). Quote the path if it contains spaces.
# Example (Windows):
#   EXCEL_SOURCE_PATH="C:\Users\you\Documents\your_screener.xlsx"
EXCEL_SOURCE_PATH=
