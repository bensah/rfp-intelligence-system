# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend (Settings -> API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=rfp-bot@your-verified-domain.com

# Streamlit cookie signing secret (random 32+ char string)
APP_SECRET_KEY=change-me-to-a-long-random-string

# Admin notifications
ADMIN_EMAIL=nbernard@clintonhealthaccess.org

# Optional — absolute path to the master Excel workbook. The app auto-syncs
# when the file's mtime is newer than the last recorded sync (shown on
# Admin > Settings). Quote the path if it contains spaces.
# Example:
#   EXCEL_SOURCE_PATH="C:\Users\nbernard\OneDrive - Clinton Health Access Initiative, Inc\Documents\CHAI_Cameroon_RFP_Eligibility_Screener.xlsx"
EXCEL_SOURCE_PATH=
